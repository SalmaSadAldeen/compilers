BRACE_VALUE_RPAREN : RPAREN -> type(RPAREN), mode(BRACE_MODE);
BRACE_VALUE_LBRACE : LBRACE -> type(LBRACE), mode(BRACE_MODE), pushMode(BRACE_MODE);
BRACE_VALUE_RBRACE : RBRACE -> type(RBRACE), popMode;
BRACE_VALUE_LBRACKET : LBRACKET -> type(LBRACKET), mode(BRACE_MODE);
BRACE_VALUE_RBRACKET : RBRACKET -> type(RBRACKET), mode(BRACE_MODE);
BRACE_VALUE_SEMI : SEMI -> type(SEMI), mode(BRACE_MODE);
BRACE_VALUE_COMMA : COMMA -> type(COMMA), mode(BRACE_MODE);
BRACE_VALUE_COLON : COLON -> type(COLON), mode(BRACE_MODE);
